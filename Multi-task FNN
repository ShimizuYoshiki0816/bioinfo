import pandas as pd
import numpy as np
import tensorflow as tf
from tensorflow.keras.models import Model
from tensorflow.keras.layers import Input, Dense
from tensorflow.keras.optimizers import RMSprop
from sklearn.model_selection import KFold
from sklearn.metrics import mean_squared_error
from sklearn.preprocessing import StandardScaler
from scipy.stats import pearsonr
import random

# --- データ ---
pheno = pd.read_csv("~/pheno.csv")
geno = pd.read_csv("~/geno.csv")
data = pd.concat([pheno[["HC", "SL"]], geno], axis=1).dropna()

X = data.drop(columns=["HC", "SL"]).values.astype(float)
y_main = data["HC"].values
y_aux = data["SL"].values

# --- モデル ---
def build_multitask_model(input_dim):
    inputs = Input(shape=(input_dim,))

    shared = Dense(200, activation='relu')(inputs)

    main_branch = Dense(20, activation='relu')(shared)
    main_output = Dense(1, activation='linear', name="HC")(main_branch)

    aux_branch = Dense(100, activation='relu')(shared)
    aux_output = Dense(1, activation='linear', name="SL")(aux_branch)

    model = Model(inputs=inputs, outputs=[main_output, aux_output])

    model.compile(
        optimizer=RMSprop(),
        loss={'HC': 'mse', 'SL': 'mse'},
        loss_weights={'HC': 1.0, 'SL': 0.5}  # ← 重要
    )
    return model

# --- CV ---
n_repeats = 10
n_folds = 5
input_dim = X.shape[1]

corrs, mses = [], []

for repeat in range(n_repeats):
    seed = 100 + repeat
    print(f"Repeat {repeat+1} (seed={seed})")

    # ← 再現性確保（重要）
    np.random.seed(seed)
    tf.random.set_seed(seed)
    random.seed(seed)

    kf = KFold(n_splits=n_folds, shuffle=True, random_state=seed)

    for fold, (train_idx, test_idx) in enumerate(kf.split(X)):
        print(f"  Fold {fold+1}")

        X_train, X_test = X[train_idx], X[test_idx]
        y_main_train, y_main_test = y_main[train_idx], y_main[test_idx]
        y_aux_train, y_aux_test = y_aux[train_idx], y_aux[test_idx]

        # ← スケーリング（重要）
        scaler_X = StandardScaler()
        X_train = scaler_X.fit_transform(X_train)
        X_test = scaler_X.transform(X_test)

        model = build_multitask_model(input_dim)

        model.fit(
            X_train,
            {'HC': y_main_train, 'SL': y_aux_train},
            epochs=30,
            batch_size=128,
            verbose=0
        )

        y_main_pred = model.predict(X_test)[0].ravel()

        if np.std(y_main_test) == 0 or np.std(y_main_pred) == 0:
            continue

        corr = pearsonr(y_main_test, y_main_pred)[0]
        mse = mean_squared_error(y_main_test, y_main_pred)

        corrs.append(corr)
        mses.append(mse)

# --- 結果 ---
if len(corrs) > 0:
    mean_r = np.mean(corrs)
    se_r = np.std(corrs, ddof=1) / np.sqrt(len(corrs))
    mean_mse = np.mean(mses)
    se_mse = np.std(mses, ddof=1) / np.sqrt(len(mses))

    print("\n==== Multi-task FNN Predictive Performance ====")
    print(f"Mean Pearson's r : {mean_r:.4f} ± {se_r:.4f}")
    print(f"Mean MSE         : {mean_mse:.4f} ± {se_mse:.4f}")
else:
    print("No valid folds")
