library(BGLR)

n <- length(Y)
n_repeats <- 10   # 繰り返し回数
n_folds <- 5     # fold 数

# 予測能を保存する行列
pred_corrsLHC <- matrix(NA, nrow = n_repeats, ncol = n_folds)

for (r in 1:n_repeats) {
  seed_r <- 100 + r 
  set.seed(seed_r)
  
  cat("Repeat", r, "\n")
  
  folds <- sample(rep(1:n_folds, length.out = n))
  y_hatLHC <- rep(NA, n)
  
  for (k in 1:n_folds) {
    cat("  Fold", k, "\n")
    
    test_idx <- which(folds == k)
    y_cv <- Y
    y_cv[test_idx] <- NA
    
    modelLHC <- BGLR(
      y = y_cv,
      ETA = list(list(X = X, model = "BL")),
      nIter = 10000,
      burnIn = 2000,
      verbose = FALSE
    )
    
    y_hatLHC[test_idx] <- modelLHC$yHat[test_idx]
    
    # foldごとの予測能（Pearsonのr）を保存
    pred_corrsLHC[r, k] <- cor(Y[test_idx], y_hatLHC[test_idx], use = "complete.obs")
  }
}

# 全体の平均と標準誤差
mean_predLHC <- mean(pred_corrsLHC, na.rm = TRUE)
se_predLHC <- sd(pred_corrsLHC, na.rm = TRUE) / sqrt(n_repeats * n_folds)

cat("\n==== BL Predictive Ability ====\n")
cat("Mean Pearson's r:", round(mean_predLHC, 4), "\n")
cat("Standard Error  :", round(se_predLHC, 4), "\n")
