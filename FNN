import pandas as pd
import numpy as np
import gc
from sklearn.model_selection import KFold
from sklearn.metrics import mean_squared_error
from scipy.stats import pearsonr
import tensorflow as tf
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Input, Dense
from tensorflow.keras.optimizers import Adam

# --- データ読み込み ---
pheno = pd.read_csv("~/pheno.csv")
geno = pd.read_csv("~/geno.csv")

# --- 欠損除去 ---
data = pd.concat([pheno[["HC"]], geno], axis=1).dropna()
y = data["HC"].values
X = data.drop(columns="HC").values

# --- モデル定義 ---
def build_fnn(input_dim):
    model = Sequential([
        Input(shape=(input_dim,)),
        Dense(200, activation='relu'),
        Dense(20, activation='relu'),
        Dense(1, activation='linear')
    ])
    model.compile(optimizer=Adam(), loss='mean_squared_error', metrics=['mean_squared_error'])
    return model

# --- 交差検証 ---
n_repeats = 10
n_folds = 5
input_dim = X.shape[1]

corrs = []
mses = []

for repeat in range(n_repeats):
    seed = 100 + repeat
    print(f"Repeat {repeat + 1} (seed={seed})")
    
    kf = KFold(n_splits=n_folds, shuffle=True, random_state=seed)

    for fold, (train_idx, test_idx) in enumerate(kf.split(X)):
        print(f"  Fold {fold+1}")
        
        X_train, X_test = X[train_idx], X[test_idx]
        y_train, y_test = y[train_idx], y[test_idx]

        model = build_fnn(input_dim)
        model.fit(X_train, y_train, epochs=30, batch_size=128, verbose=0)

        y_pred = model.predict(X_test).ravel()

        # 分散チェック
        if np.std(y_test) == 0 or np.std(y_pred) == 0:
            print(f"    Fold {fold+1} skipped due to zero variance.")
            continue

        corr = pearsonr(y_test, y_pred)[0]
        mse = mean_squared_error(y_test, y_pred)

        print("    実測値 vs 予測値（先頭5件）:")
        for true_val, pred_val in zip(y_test[:5], y_pred[:5]):
            print(f"      実測: {true_val:.3f}, 予測: {pred_val:.3f}")

        if not np.isnan(corr) and not np.isnan(mse):
            corrs.append(corr)
            mses.append(mse)

        tf.keras.backend.clear_session()
        gc.collect()

# --- 結果 ---
if corrs and mses:
    mean_r = np.mean(corrs)
    se_r = np.std(corrs, ddof=1) / np.sqrt(len(corrs))

    print("\n==== Predictive Performance ====")
    print(f"Mean Pearson's r : {mean_r:.4f} ± {se_r:.4f}")
    print(f"Mean MSE         : {np.mean(mses):.4f}")
else:
    print("No valid folds.")
